# --- upstream ---
MODEL_ID=moonshotai/kimi-k3
MAX_REQ_PER_MIN=40
KEEPALIVE_SECS=10
# --- browser ---
HEADLESS=1
NAV_TIMEOUT_MS=60000
HYDRATION_WAIT_MS=4000
# --- server ---
HOST=127.0.0.1
PORT=8000
# --- swarm ---
SWARM_MAX_CONCURRENCY=8
SWARM_BUDGET_S=1800
SWARM_TIMEOUT_PER_ITEM_S=420
# --- agent ---
AGENT_BASE_URL=http://127.0.0.1:8000/v1
AGENT_API_KEY=local
AGENT_MODEL=moonshotai/kimi-k3
AGENT_MAX_STEPS=40
AGENT_ROOT=/content/kimi-super-agent
# DIRECT=1  # uncomment to let MCP/agent call NVIDIA directly (no server needed)
# --- smart multi-provider proxy (user keys; comma-separated for rotation) ---
# GPT-5 family (paid, platform.openai.com):
# OPENAI_API_KEY=sk-...
# Claude 5 gen: fable-5 / opus-5 / sonnet-5 (paid, console.anthropic.com):
# ANTHROPIC_API_KEY=sk-ant-...
# One key for 50+ models incl. GPT-5 + Claude (openrouter.ai, free models need no card):
# OPENROUTER_API_KEY=sk-or-...
# Pollinations reliability key (free at enter.pollinations.ai; anonymous is flaky):
# POLLINATIONS_API_KEY=
# Free tiers, no card (ai.google.dev / console.groq.com / cloud.cerebras.ai):
# GEMINI_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# Optional daily token budgets + circuit-breaker tuning:
# OPENAI_MAX_TOKENS_PER_DAY=1000000
# PROVIDER_CB_FAILURES=3
# PROVIDER_CB_COOLDOWN_S=120
# PROVIDER_TIMEOUT_S=120
# PROVIDER_MAX_TOKENS=1024
